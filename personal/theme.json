  "css": "[data-sidebar-card-layout=\"compact\"] {\n  height: 3.75rem !important;\n}\n[data-sidebar-card-layout=\"compact\"] [data-sidebar-card-metadata],\n[data-sidebar-card-layout=\"single-line\"] [data-sidebar-card-metadata] {\n  display: none;\n}\n[data-sidebar-card-layout=\"compact\"] [data-sidebar-project-name] {\n  flex: 0 1 auto;\n}\n[data-sidebar-card-layout=\"single-line\"] {\n  display: flex;\n  height: 2rem !important;\n  align-items: center;\n  gap: 0.5rem;\n  padding-block: 0;\n}\n[data-sidebar-card-layout=\"single-line\"] [data-sidebar-card-header] {\n  display: contents;\n}\n[data-sidebar-card-layout=\"single-line\"]\n  [data-sidebar-card-header]\n  > :not([data-sidebar-project-icon]) {\n  display: none;\n}\n[data-sidebar-card-layout=\"single-line\"] [data-sidebar-card-title] {\n  flex: 1;\n  margin-top: 0;\n}\n[data-sidebar-pinned-icons] {\n  flex-wrap: wrap;\n  align-content: flex-start;\n  height: auto !important;\n  padding-block: 0.25rem;\n  gap: 0.25rem;\n  padding-inline: 0.25rem;\n}\n[data-sidebar-pin-button] {\n  width: 2.25rem;\n  height: 2.25rem;\n  border-radius: 0.375rem;\n}\n.dark [data-slot=\"composer-shell\"] {\n  --chat-composer-highlight: rgb(255 255 255 / 3%);\n  --chat-composer-outline: color-mix(in srgb, white 5%, transparent);\n}\n[data-slot=\"composer-context-strip\"] {\n  --background-image-composer-seam-below: linear-gradient(\n    to bottom,\n    transparent 0 1rem,\n    rgb(0 0 0 / 18%) 1rem,\n    transparent calc(1rem + 10px)\n  );\n}\n"
